# Staging environment template for KnowLens
# Domain
NEXTAUTH_URL=https://staging.knowlens.ai
NEXT_PUBLIC_SITE_URL=https://staging.knowlens.ai
NEXTAUTH_SECRET=replace-with-32-plus-random-secret

# Auth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NEXT_PUBLIC_GOOGLE_ONE_TAP_CLIENT_ID=replace-with-google-client-id
NEXTAUTH_ALLOW_DEV_LOGIN=false
NEXTAUTH_RELAX_OAUTH_CHECKS_LOCAL=false
NEXTAUTH_ONE_TAP_UNSAFE_LOCAL_FALLBACK=false

# Stripe (test mode for staging)
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_ESSENTIAL_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_ESSENTIAL_YEARLY=price_xxx
NEXT_PUBLIC_STRIPE_CREATOR_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_CREATOR_YEARLY=price_xxx
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY=price_xxx

# Stripe optional payment links
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STARTER_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STARTER_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_CREATOR_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_CREATOR_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO_YEARLY=

# Free LLM
GPTSAPI_API_KEY=replace-with-gptsapi-key
GPTSAPI_MODEL_GEMINI_25=gemini-2.5-flash
GPTSAPI_MODEL_DEEPSEEK_V4=deepseek-v4

# Paid LLM
PAID_LLM_CHAT_COMPLETIONS_URL=https://api.tu-zi.com/v1/chat/completions
PAID_LLM_API_KEY=replace-with-paid-llm-key
PAID_MODEL_GPT_55=gpt-5.5
PAID_MODEL_GPT_54=gpt-5.4
PAID_MODEL_GEMINI_31_PRO=gemini-3.1-pro
PAID_MODEL_CLAUDE_SONNET_46=claude-sonnet-4.6

# Image2
IMAGE2_PROVIDER_ENDPOINT=https://api.tu-zi.com/v1/images/edits
IMAGE2_PROVIDER_API_KEY=replace-with-image2-key
IMAGE2_PROVIDER_MODEL=gpt-image-2

# Optional: YouTube/podcast fallback transcription
OPENAI_API_KEY=

